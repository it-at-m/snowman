name: Backend Tests

on:
    pull_request:
        paths:
            - "{{ module_name }}-backend/**"
            - ".github/workflows/backend-tests.yml"

permissions:
    contents: read

jobs:
    backend-tests:
        runs-on: ubuntu-latest
        defaults:
            run:
                working-directory: "{{ module_name }}-backend"
        steps:
            - uses: actions/checkout@v4
            - uses: astral-sh/setup-uv@v4
              with:
                  python-version-file: "{{ module_name }}-backend/.python-version"
            - name: Install dependencies
              run: uv sync --group dev
            - name: Run backend tests
              run: uv run pytest
