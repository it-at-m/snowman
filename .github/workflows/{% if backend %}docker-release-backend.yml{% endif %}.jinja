name: Build and Release Backend Docker Image

permissions:
    contents: read

on:
    push:
        tags:
            - "backend-*"
    workflow_dispatch:
        inputs:
            tag:
                description: "Backend tag to release (e.g., backend-1.0.0)"
                required: true
                default: "backend-latest"

jobs:
    build-and-push-backend:
        runs-on: ubuntu-latest
        permissions:
            packages: write
        steps:
            - uses: actions/checkout@v4.2.2
            - uses: docker/setup-qemu-action@v3.6.0
            - uses: docker/setup-buildx-action@v3.11.1
            - uses: docker/login-action@v3.4.0
              with:
                  registry: ghcr.io
                  username: {% raw %}${{ github.actor }}{% endraw %}
                  password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
            - name: Extract version from backend tag
              id: vars
              run: |
                  if [[ "{% raw %}${{ github.event_name }}{% endraw %}" == "workflow_dispatch" ]]; then
                      FULL_TAG="{% raw %}${{ github.event.inputs.tag }}{% endraw %}"
                  else
                      FULL_TAG=${GITHUB_REF#refs/tags/}
                  fi

                  if [[ "$FULL_TAG" =~ ^backend-(.+)$ ]]; then
                      VERSION="${BASH_REMATCH[1]}"
                  else
                      echo "Error: Tag must start with 'backend-'"
                      exit 1
                  fi

                  echo "version=${VERSION}" >> "$GITHUB_OUTPUT"
                  echo "repo_lowercase=$(echo '{% raw %}${{ github.repository }}{% endraw %}' | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_OUTPUT"
            - uses: docker/build-push-action@v6.18.0
              with:
                  context: ./{{ module_name }}-backend
                  file: ./{{ module_name }}-backend/Dockerfile
                  push: true
                  sbom: true
                  provenance: true
                  tags: |
                      ghcr.io/{% raw %}${{ steps.vars.outputs.repo_lowercase }}{% endraw %}/{{ project_name }}-backend:{% raw %}${{ steps.vars.outputs.version }}{% endraw %}
                      ghcr.io/{% raw %}${{ steps.vars.outputs.repo_lowercase }}{% endraw %}/{{ project_name }}-backend:latest
                  cache-from: type=gha
                  cache-to: type=gha,mode=max
