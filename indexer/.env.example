HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,.svc.cluster.local

# Dense embedding API (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMB_MAX_RETRIES=2
EMB_TIMEOUT=10

# Qdrant and collection contract shared with the MCP retriever
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VDB_TIMEOUT=100
VDB_COLLECTION_NAME=snow-search
VDB_DENSE_VECTOR_NAME=dense
VDB_SPARSE_VECTOR_NAME=sparse

# Generic indexing behavior
INDEXING_MODE=hybrid
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
SPARSE_EMBEDDING_LANGUAGE=german
FASTEMBED_CACHE_PATH=./model_cache
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200
INDEXING_BATCH_SIZE=20
ALLOW_EMPTY_SNAPSHOT=false

# ServiceNow example adapter
SERVICENOW_URL=https://example.service-now.com
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
# Optional; defaults to https://<instance>/oauth_token.do
SERVICENOW_TOKEN_URL=
SERVICENOW_OAUTH_SCOPE=knowledge
SERVICENOW_VERIFY_SSL=true
SERVICENOW_PAGE_SIZE=100
SERVICENOW_LANGUAGES=de,en
