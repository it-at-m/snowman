#######
# MCP #
#######
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8080
MCP_PATH=/mcp
MCP_LOG_LEVEL=INFO
MCP_DNS_REBINDING_PROTECTION=true
# Comma-separated. Defaults to local hosts for MCP_PORT when unset.
MCP_ALLOWED_HOSTS=
# Comma-separated. Leave empty for non-browser agent clients.
MCP_ALLOWED_ORIGINS=

#########
# Proxy #
#########
HTTP_PROXY=http://internet-proxy-client.muenchen.de:80
HTTPS_PROXY=http://internet-proxy-client.muenchen.de:80
NO_PROXY=localhost,.muenchen.de

###########
# litellm #
###########
OPENAI_API_KEY=
OPENAI_API_BASE=

############
# Reranker #
############
RERANK_MODEL=cohere-rerank-v4.0-fast
VDB_RERANK_ENABLED=True

##########
# Qdrant #
##########
QDRANT_URL=
QDRANT_READONLY_API_KEY=
VDB_TIMEOUT=100
VDB_RETRIEVAL_SCORE_THRESHOLD=0.8
VDB_RETRIEVAL_N_DOCS=20
VDB_RETRIEVAL_FINAL_N_DOCS=5
VDB_RETRIEVAL_FUSION=DBSF
VDB_DENSE_VECTOR_NAME=dense
VDB_SPARSE_VECTOR_NAME=sparse
VDB_COLLECTIONS=

###################
# Retrieval tools #
###################
# JSON conditions applied to every generated retrieval tool.
VDB_FILTER_BASE_CONDITIONS=[{"field":"metadata.source_id","values":["snow-kb"]}]

# JSON tool definitions. Conditions are ANDed; values inside a condition are ORed.
VDB_RETRIEVAL_TOOLS=[{"name":"search_snow_knowledge_base","title":"Search SNOW knowledge base","description":"Search generally available company SNOW knowledge-base articles.","conditions":[]},{"name":"search_eakte_knowledge_base","title":"Search E-Akte knowledge base","description":"Search company knowledge for E-Akte processes, functions, permissions, retention, and troubleshooting.","conditions":[{"field":"metadata.topic","values":["eakte"]}]},{"name":"search_personalwesen_knowledge_base","title":"Search Personalwesen knowledge base","description":"Search company knowledge for HR and personnel processes.","conditions":[{"field":"metadata.topic","values":["personalwesen"]}]},{"name":"search_it_services_knowledge_base","title":"Search IT services knowledge base","description":"Search company knowledge for IT services, access, devices, software, and support.","conditions":[{"field":"metadata.topic","values":["it_services"]}]}]

